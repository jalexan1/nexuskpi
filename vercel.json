{
  "redirects": [
    { "source": "/despachos", "destination": "/despachos/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/despachos/:path*", "destination": "https://logistic-portal.vercel.app/despachos/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY"    },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" }
      ]
    }
  ]
}
